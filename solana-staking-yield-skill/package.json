{
  "name": "solana-staking-yield-skill",
  "version": "1.0.0",
  "description": "Validator selection, native staking, and LST (liquid staking token) yield comparison for Solana AI agents",
  "type": "module",
  "main": "scripts/index.mjs",
  "bin": {
    "solana-staking-yield": "scripts/index.mjs"
  },
  "scripts": {
